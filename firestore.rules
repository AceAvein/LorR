rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // READ needs resource (existing doc). request.resource is WRITE-only — that broke pull.
      allow read: if request.auth != null
                  && resource.data.deviceId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.deviceId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.deviceId == request.auth.uid
                    && request.resource.data.deviceId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.deviceId == request.auth.uid;

      match /modules/{moduleId}/{document=**} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/users/$(userId)).data.deviceId
                              == request.auth.uid;
      }
    }

    match /devices/{deviceId} {
      allow read, write: if request.auth != null
                         && deviceId == request.auth.uid;
    }
  }
}
