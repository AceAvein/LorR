rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function ownsUser(userId) {
      return signedIn()
        && userExists(userId)
        && userDoc(userId).data.deviceId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);

      allow create: if signedIn()
                    && request.resource.data.deviceId == request.auth.uid;

      allow update: if ownsUser(userId)
                    && request.resource.data.deviceId == request.auth.uid;

      allow delete: if ownsUser(userId);

      match /modules/{moduleId} {
        allow read, write: if ownsUser(userId);

        match /phases/{phaseId} {
          allow read, write: if ownsUser(userId);

          match /days/{dayId} {
            allow read, write: if ownsUser(userId);
          }
        }
      }

      match /clinicSchedule/{dayId} {
        allow read, write: if ownsUser(userId);
      }
    }

    match /devices/{deviceId} {
      allow read, write: if signedIn() && deviceId == request.auth.uid;
    }
  }
}
